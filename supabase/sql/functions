slugify,"CREATE OR REPLACE FUNCTION public.slugify(v text)
 RETURNS text
 LANGUAGE plpgsql
 IMMUTABLE STRICT
AS $function$
DECLARE
  res TEXT := lower(v);
BEGIN
  -- Sostituiamo le vocali accentate italiane (e altre più comuni)
  res := translate(res, 'àáâãäåèéêëìíîïòóôõöùúûüñç', 'aaaaaaeeeeiiiiooooouuuunc');
  -- Sostituiamo tutto ciò che non è lettera o numero con un trattino
  res := regexp_replace(res, '[^a-z0-9]+', '-', 'g');
  -- Rimuoviamo eventuali trattini all'inizio o alla fine
  res := trim(BOTH '-' FROM res);
  RETURN res;
END;
$function$
;"
