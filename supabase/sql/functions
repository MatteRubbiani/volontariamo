accetta_invito_sicuro,"CREATE OR REPLACE FUNCTION public.accetta_invito_sicuro(token_invito text)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_user_id UUID;
  v_invito_id UUID;
  v_impresa_id UUID;
BEGIN
  v_user_id := auth.uid();
  IF v_user_id IS NULL THEN
    RAISE EXCEPTION 'Devi essere loggato per accettare un invito.';
  END IF;

  -- AGGIUNTO IL CAST ::uuid QUI SOTTO
  SELECT id, impresa_id INTO v_invito_id, v_impresa_id
  FROM inviti_impresa
  WHERE token = token_invito::uuid AND stato = 'in_attesa'
  FOR UPDATE; 

  IF v_invito_id IS NULL THEN
    RAISE EXCEPTION 'Link non valido o già utilizzato.';
  END IF;

  -- Inserimento del dipendente
  INSERT INTO impresa_dipendenti (impresa_id, volontario_id, stato, ruolo_aziendale)
  VALUES (v_impresa_id, v_user_id, 'attivo', 'dipendente');

  -- Brucia il token
  UPDATE inviti_impresa SET stato = 'accettato' WHERE id = v_invito_id;

  RETURN TRUE;
END;
$function$
;"
cerca_directory_unificata,"CREATE OR REPLACE FUNCTION public.cerca_directory_unificata(search_query text DEFAULT NULL::text)
 RETURNS TABLE(id uuid, denominazione text, codice_fiscale character varying, sezione_runts character varying, comune character varying, is_claimed boolean, stato_verifica character varying, logo_url text, slug character varying, lat double precision, lng double precision, is_registrata boolean, rank real)
 LANGUAGE plpgsql
AS $function$
DECLARE
  q_clean TEXT;
  tokens TEXT[];
BEGIN
  q_clean := LOWER(TRIM(COALESCE(search_query, '')));

  -- 1. SE LA RICERCA È VUOTA: Mostriamo solo gli enti registrati sulla piattaforma
  IF q_clean = '' THEN
    RETURN QUERY
    SELECT 
      a.id::UUID, a.denominazione::TEXT, a.codice_fiscale::VARCHAR(16),
      COALESCE(a.sezione_runts, 'Ente Registrato')::VARCHAR(100),
      COALESCE(a.comune, 'Modena')::VARCHAR(100),
      COALESCE(a.claimed, true)::BOOLEAN, COALESCE(a.stato_verifica, 'verificato')::VARCHAR(20),
      a.logo_url::TEXT, a.slug::VARCHAR(255), a.lat::DOUBLE PRECISION, a.lng::DOUBLE PRECISION,
      true::BOOLEAN as is_registrata, 1.0::REAL as score
    FROM associazioni a
    ORDER BY a.denominazione ASC
    LIMIT 30;
    RETURN;
  END IF;

  tokens := string_to_array(q_clean, ' ');

  RETURN QUERY
  WITH risultati_grezzi AS (
    -- A. MATCH SU ASSOCIAZIONI REGISTRATE (Con boost visibilità)
    SELECT 
      a.id::UUID, a.denominazione::TEXT, a.codice_fiscale::VARCHAR(16),
      COALESCE(a.sezione_runts, 'Ente Registrato')::VARCHAR(100) as sezione_runts,
      COALESCE(a.comune, 'Modena')::VARCHAR(100) as comune,
      COALESCE(a.claimed, true)::BOOLEAN as is_claimed,
      COALESCE(a.stato_verifica, 'verificato')::VARCHAR(20) as stato_verifica,
      a.logo_url::TEXT, a.slug::VARCHAR(255), a.lat::DOUBLE PRECISION, a.lng::DOUBLE PRECISION,
      true::BOOLEAN as is_registrata,
      (
        CASE 
          WHEN LOWER(a.codice_fiscale) = q_clean THEN 200.0
          WHEN LOWER(a.denominazione) = q_clean THEN 150.0
          WHEN LOWER(a.denominazione) LIKE q_clean || '%' THEN 120.0
          WHEN LOWER(a.denominazione) LIKE '% ' || q_clean || ' %' THEN 100.0
          ELSE 80.0
        END
      )::REAL as score
    FROM associazioni a
    WHERE LOWER(a.denominazione) LIKE '%' || q_clean || '%'
       OR LOWER(COALESCE(a.comune, '')) LIKE '%' || q_clean || '%'
       OR LOWER(COALESCE(a.codice_fiscale, '')) LIKE '%' || q_clean || '%'

    UNION ALL

    -- B. MATCH SU RUNTS IMPORT (Calcolo dello Score Chirurgico)
    SELECT 
      r.id::UUID, r.denominazione::TEXT, r.codice_fiscale::VARCHAR(16),
      COALESCE(r.sezione_runts, 'Iscritto al RUNTS')::VARCHAR(100) as sezione_runts,
      COALESCE(r.comune, 'Sede da definire')::VARCHAR(100) as comune, 
      false::BOOLEAN as is_claimed, 'unclaimed'::VARCHAR(20) as stato_verifica,
      NULL::TEXT as logo_url, NULL::VARCHAR(255) as slug,
      NULL::DOUBLE PRECISION as lat, NULL::DOUBLE PRECISION as lng,
      false::BOOLEAN as is_registrata,
      (
        CASE 
          -- Match Esatto Codice Fiscale
          WHEN LOWER(r.codice_fiscale) = q_clean THEN 100.0
          
          -- Match Esatto Nome (""gruppo bip"")
          WHEN LOWER(r.denominazione) = q_clean THEN 95.0
          
          -- Inizia esattamente con le parole cercate (""gruppo bip ..."")
          WHEN LOWER(r.denominazione) LIKE q_clean || '%' THEN 85.0 - (LENGTH(r.denominazione) * 0.1)
          
          -- Contiene la frase intera nel nome (""... gruppo bip ..."")
          WHEN LOWER(r.denominazione) LIKE '% ' || q_clean || ' %' 
            OR LOWER(r.denominazione) LIKE '% ' || q_clean THEN 75.0 - (LENGTH(r.denominazione) * 0.1)
          
          -- Contiene TUTTI i token/parole individuali cercati (es: sia ""GRUPPO"" che ""BIP"")
          WHEN NOT EXISTS (
            SELECT 1 FROM unnest(tokens) tok 
            WHERE tok <> '' AND LOWER(r.denominazione) NOT LIKE '%' || tok || '%'
          ) THEN 50.0 - (LENGTH(r.denominazione) * 0.1)
          
          -- Match generico / debole
          ELSE 10.0
        END
      )::REAL as score
    FROM runts_import r
    WHERE NOT EXISTS (
      SELECT 1 FROM associazioni a WHERE a.codice_fiscale IS NOT NULL AND a.codice_fiscale = r.codice_fiscale AND a.claimed = true
    )
    AND (
      -- Filtro di sicurezza: Deve contenere almeno TUTTI i token cercati
      NOT EXISTS (
        SELECT 1 FROM unnest(tokens) tok 
        WHERE tok <> '' 
          AND LOWER(r.denominazione) NOT LIKE '%' || tok || '%'
          AND LOWER(COALESCE(r.comune, '')) NOT LIKE '%' || tok || '%'
          AND LOWER(COALESCE(r.codice_fiscale, '')) NOT LIKE '%' || tok || '%'
      )
    )
  )
  SELECT 
    res.id, res.denominazione, res.codice_fiscale, res.sezione_runts, res.comune, 
    res.is_claimed, res.stato_verifica, res.logo_url, res.slug, res.lat, res.lng, 
    res.is_registrata, res.score
  FROM risultati_grezzi res
  -- L'ordinamento d'ora in poi si basa RIGOROSAMENTE sul Punteggio di Rilevanza
  ORDER BY res.score DESC, res.is_registrata DESC, LENGTH(res.denominazione) ASC
  LIMIT 15;
END;
$function$
;"
cerca_posizioni_vicine,"CREATE OR REPLACE FUNCTION public.cerca_posizioni_vicine(user_lat double precision, user_lng double precision, raggio_km double precision)
 RETURNS TABLE(id uuid, associazione_id uuid, titolo text, descrizione text, tipo text, quando text, dove text, created_at timestamp with time zone, data_esatta date, ora_inizio time without time zone, ora_fine time without time zone, giorni_settimana text[], coords text)
 LANGUAGE plpgsql
AS $function$
BEGIN
  RETURN QUERY
  SELECT 
    p.id, p.associazione_id, p.titolo, p.descrizione, p.tipo, p.quando, p.dove, 
    p.created_at, p.data_esatta, p.ora_inizio, p.ora_fine, p.giorni_settimana,
    ST_AsText(p.coords) as coords
  FROM posizioni p
  WHERE p.coords IS NOT NULL
    -- 🛡️ Solo attive e non scadute
    AND (p.stato IS NULL OR p.stato NOT IN ('bozza', 'conclusa', 'archiviata'))
    AND (p.tipo <> 'una_tantum' OR p.data_esatta IS NULL OR p.data_esatta >= CURRENT_DATE)
    AND ST_DWithin(
      p.coords, 
      ST_SetSRID(ST_MakePoint(user_lng, user_lat), 4326), 
      raggio_km * 1000
    );
END;
$function$
;"
