get_dashboard_volontario_feed,"CREATE OR REPLACE FUNCTION public.get_dashboard_volontario_feed(p_volontario_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
    v_citta text;
    v_tags uuid[];
    v_comp uuid[];
    v_consigliate jsonb;
    v_vicine jsonb;
    v_ultime jsonb;
    v_una_tantum jsonb;
BEGIN
    -- A. Recupero città e preferenze volontario
    SELECT citta_residenza INTO v_citta FROM volontari WHERE id = p_volontario_id;
    SELECT COALESCE(array_agg(tag_id), '{}') INTO v_tags FROM volontario_tags WHERE volontario_id = p_volontario_id;
    SELECT COALESCE(array_agg(competenza_id), '{}') INTO v_comp FROM volontario_competenze WHERE volontario_id = p_volontario_id;

    -- B. Query Base con FILTRO WHITELIST RIGIDO
    WITH posizioni_base AS (
        SELECT 
            p.id,
            p.titolo,
            p.descrizione,
            p.tipo,
            p.quando,
            p.data_esatta,
            p.ora_inizio,
            p.ora_fine,
            p.dove,
            p.slug,
            p.created_at,
            ma.url AS img_url,
            jsonb_build_object(
                'id', a.id,
                'denominazione', COALESCE(a.nome_breve, a.denominazione, 'Associazione'),
                'logo_url', a.logo_url,
                'slug', a.slug
            ) AS associazione,
            COALESCE((
                SELECT jsonb_agg(jsonb_build_object('id', t.id, 'name', t.name))
                FROM posizione_tags pt
                JOIN tags t ON t.id = pt.tag_id
                WHERE pt.posizione_id = p.id
            ), '[]'::jsonb) AS tags,
            COALESCE((
                SELECT jsonb_agg(jsonb_build_object('id', c.id, 'name', c.name))
                FROM posizione_competenze pc
                JOIN competenze c ON c.id = pc.competenza_id
                WHERE pc.posizione_id = p.id
            ), '[]'::jsonb) AS competenze,
            -- Calcolo Score
            (
                (COALESCE((SELECT COUNT(*) FROM posizione_tags pt WHERE pt.posizione_id = p.id AND pt.tag_id = ANY(v_tags)), 0) * 35) +
                (COALESCE((SELECT COUNT(*) FROM posizione_competenze pc WHERE pc.posizione_id = p.id AND pc.competenza_id = ANY(v_comp)), 0) * 25) +
                (CASE WHEN v_citta IS NOT NULL AND v_citta <> '' AND p.dove ILIKE '%' || v_citta || '%' THEN 20 ELSE 0 END)
            ) AS match_score
        FROM posizioni p
        LEFT JOIN associazioni a ON a.id = p.associazione_id
        LEFT JOIN media_associazioni ma ON p.immagine_id = ma.id
        WHERE 
            -- 🛡️ REGOLA 1: SOLO posizioni esplicitamente aperte/pubblicate
            p.stato IN ('pubblicata', 'aperta')
            -- 🛡️ REGOLA 2: Se evento singolo, la data DEVE essere oggi o futura
            AND (p.tipo <> 'una_tantum' OR (p.data_esatta IS NOT NULL AND p.data_esatta >= CURRENT_DATE))
    ),
    consigliate_query AS (
        SELECT jsonb_build_object(
            'id', id, 'titolo', titolo, 'descrizione', descrizione, 'tipo', tipo,
            'quando', quando, 'data_esatta', data_esatta, 'ora_inizio', ora_inizio, 'ora_fine', ora_fine,
            'dove', dove, 'slug', slug, 'created_at', created_at, 'associazione', associazione,
            'tags', tags, 'competenze', competenze, 'match_score', match_score,
            'immagine_url', img_url,
            'media_associazioni', CASE WHEN img_url IS NOT NULL THEN jsonb_build_object('url', img_url) ELSE NULL END
        ) AS item
        FROM posizioni_base
        ORDER BY match_score DESC, created_at DESC
        LIMIT 10
    ),
    vicine_query AS (
        SELECT jsonb_build_object(
            'id', id, 'titolo', titolo, 'descrizione', descrizione, 'tipo', tipo,
            'quando', quando, 'data_esatta', data_esatta, 'ora_inizio', ora_inizio, 'ora_fine', ora_fine,
            'dove', dove, 'slug', slug, 'created_at', created_at, 'associazione', associazione,
            'tags', tags, 'competenze', competenze, 'match_score', match_score,
            'immagine_url', img_url,
            'media_associazioni', CASE WHEN img_url IS NOT NULL THEN jsonb_build_object('url', img_url) ELSE NULL END
        ) AS item
        FROM posizioni_base
        WHERE v_citta IS NOT NULL AND v_citta <> '' AND dove ILIKE '%' || v_citta || '%'
        ORDER BY created_at DESC
        LIMIT 10
    ),
    ultime_query AS (
        SELECT jsonb_build_object(
            'id', id, 'titolo', titolo, 'descrizione', descrizione, 'tipo', tipo,
            'quando', quando, 'data_esatta', data_esatta, 'ora_inizio', ora_inizio, 'ora_fine', ora_fine,
            'dove', dove, 'slug', slug, 'created_at', created_at, 'associazione', associazione,
            'tags', tags, 'competenze', competenze, 'match_score', match_score,
            'immagine_url', img_url,
            'media_associazioni', CASE WHEN img_url IS NOT NULL THEN jsonb_build_object('url', img_url) ELSE NULL END
        ) AS item
        FROM posizioni_base
        ORDER BY created_at DESC
        LIMIT 10
    ),
    una_tantum_query AS (
        SELECT jsonb_build_object(
            'id', id, 'titolo', titolo, 'descrizione', descrizione, 'tipo', tipo,
            'quando', quando, 'data_esatta', data_esatta, 'ora_inizio', ora_inizio, 'ora_fine', ora_fine,
            'dove', dove, 'slug', slug, 'created_at', created_at, 'associazione', associazione,
            'tags', tags, 'competenze', competenze, 'match_score', match_score,
            'immagine_url', img_url,
            'media_associazioni', CASE WHEN img_url IS NOT NULL THEN jsonb_build_object('url', img_url) ELSE NULL END
        ) AS item
        FROM posizioni_base
        WHERE tipo = 'una_tantum'
        ORDER BY data_esatta ASC, created_at DESC
        LIMIT 10
    )
    SELECT 
        COALESCE((SELECT jsonb_agg(item) FROM consigliate_query), '[]'::jsonb),
        COALESCE((SELECT jsonb_agg(item) FROM vicine_query), '[]'::jsonb),
        COALESCE((SELECT jsonb_agg(item) FROM ultime_query), '[]'::jsonb),
        COALESCE((SELECT jsonb_agg(item) FROM una_tantum_query), '[]'::jsonb)
    INTO v_consigliate, v_vicine, v_ultime, v_una_tantum;

    RETURN jsonb_build_object(
        'consigliate', v_consigliate,
        'vicine', v_vicine,
        'ultime', v_ultime,
        'una_tantum', v_una_tantum
    );
END;
$function$
;"
get_profili_candidati,"CREATE OR REPLACE FUNCTION public.get_profili_candidati(p_posizione_id uuid)
 RETURNS SETOF volontari
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
begin
  -- Controllo di Sicurezza Invalicabile: l'utente loggato è il creatore dell'annuncio?
  if not exists (
    select 1 from posizioni 
    where id = p_posizione_id and associazione_id = auth.uid()
  ) then
    raise exception 'Non autorizzato a visualizzare questi profili';
  end if;

  -- Se è il proprietario, restituiamo i profili dei candidati a quella posizione
  return query
  select pv.*
  from volontari pv
  join candidature c on c.volontario_id = pv.id
  where c.posizione_id = p_posizione_id;
end;
$function$
;"
