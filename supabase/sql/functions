verifica_codice_fiscale_runts,"CREATE OR REPLACE FUNCTION public.verifica_codice_fiscale_runts(cf_input text)
 RETURNS TABLE(trovato boolean, gia_rivendicato boolean, denominazione text, comune text, provincia text, sezione_runts text)
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
  clean_cf TEXT := UPPER(TRIM(cf_input));
  assoc_rec RECORD;
  runts_rec RECORD;
BEGIN
  -- A. Controlla prima se è già attiva tra le associazioni registrate
  SELECT a.denominazione, a.comune, a.provincia, a.sezione_runts, a.claimed 
  INTO assoc_rec
  FROM public.associazioni a
  WHERE UPPER(a.codice_fiscale) = clean_cf
  LIMIT 1;

  IF FOUND THEN
    RETURN QUERY SELECT 
      TRUE, 
      COALESCE(assoc_rec.claimed, FALSE), 
      assoc_rec.denominazione, 
      assoc_rec.comune::TEXT, 
      assoc_rec.provincia::TEXT, 
      assoc_rec.sezione_runts::TEXT;
    RETURN;
  END IF;

  -- B. Se non presente, cerca nell'importazione RUNTS
  SELECT r.denominazione, r.comune, r.provincia, r.sezione_runts
  INTO runts_rec
  FROM public.runts_import r
  WHERE UPPER(r.codice_fiscale) = clean_cf
  LIMIT 1;

  IF FOUND THEN
    RETURN QUERY SELECT 
      TRUE, 
      FALSE, -- Scheda non ancora rivendicata
      runts_rec.denominazione, 
      runts_rec.comune, 
      runts_rec.provincia, 
      runts_rec.sezione_runts;
    RETURN;
  END IF;

  -- C. Nessun riscontro
  RETURN QUERY SELECT FALSE, FALSE, NULL::TEXT, NULL::TEXT, NULL::TEXT, NULL::TEXT;
END;
$function$
;"
